<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="iris_drone" params="namespace xyz_offset">
    
    <joint name="${namespace}_mount_joint" type="fixed">
      <parent link="connecting_stripes"/>
      <child link="${namespace}/base_link"/>
      <origin xyz="${xyz_offset}" rpy="0 0 0"/>
    </joint>

    <link name="${namespace}/base_link">
      <inertial>
        <mass value="1.5"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.0347563" ixy="0.0" ixz="0.0" iyy="0.0458929" iyz="0.0" izz="0.0977"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="./models/meshes/iris.dae" scale="1 1 1"/>
        </geometry>
        <material name="blue">
          <color rgba="0 0 1 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.47 0.47 0.11"/>
        </geometry>
      </collision>
    </link>

    <joint name="${namespace}/rotor_0_joint" type="continuous">
      <origin rpy="0 0 0" xyz="0.13 -0.22 0.023"/>
      <axis xyz="0 0 1"/>
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/rotor_0"/>
    </joint>
    <link name="${namespace}/rotor_0">
      <inertial>
        <mass value="0.00005"/>
        <inertia ixx="9.7499961e-07" ixy="0.0" ixz="0.0" iyy="4.170414998500001e-05" iyz="0.0" izz="4.2604149625000006e-05"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="./models/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
        </geometry>
        <material name="green">
          <color rgba="0 1 0 1"/>
        </material>
      </visual>
    </link>

    <joint name="${namespace}/rotor_1_joint" type="continuous">
      <origin rpy="0 0 0" xyz="-0.13 0.2 0.023"/>
      <axis xyz="0 0 1"/>
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/rotor_1"/>
    </joint>
    <link name="${namespace}/rotor_1">
      <inertial>
        <mass value="0.00005"/>
        <inertia ixx="9.7499961e-07" ixy="0.0" ixz="0.0" iyy="4.170414998500001e-05" iyz="0.0" izz="4.2604149625000006e-05"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="./models/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
        </geometry>
        <material name="green"/>
      </visual>
    </link>

    <joint name="${namespace}/rotor_2_joint" type="continuous">
      <origin rpy="0 0 0" xyz="0.13 0.22 0.023"/>
      <axis xyz="0 0 1"/>
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/rotor_2"/>
    </joint>
    <link name="${namespace}/rotor_2">
      <inertial>
        <mass value="0.00005"/>
        <inertia ixx="9.7499961e-07" ixy="0.0" ixz="0.0" iyy="4.170414998500001e-05" iyz="0.0" izz="4.2604149625000006e-05"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="./models/meshes/propeller_cw.dae" scale="0.1 0.1 0.1"/>
        </geometry>
        <material name="red">
          <color rgba="1 0 0 1"/>
        </material>
      </visual>
    </link>

    <joint name="${namespace}/rotor_3_joint" type="continuous">
      <origin rpy="0 0 0" xyz="-0.13 -0.2 0.023"/>
      <axis xyz="0 0 1"/>
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/rotor_3"/>
    </joint>
    <link name="${namespace}/rotor_3">
      <inertial>
        <mass value="0.00005"/>
        <inertia ixx="9.7499961e-07" ixy="0.0" ixz="0.0" iyy="4.170414998500001e-05" iyz="0.0" izz="4.2604149625000006e-05"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="./models/meshes/propeller_cw.dae" scale="0.1 0.1 0.1"/>
        </geometry>
        <material name="red"/>
      </visual>
    </link>

  </xacro:macro>
</robot>